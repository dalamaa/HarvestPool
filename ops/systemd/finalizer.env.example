# Install as /etc/harvestpool/finalizer.env, owned by root and mode 0600.
# Activation remains explicit; change only this line after approval.
HARVESTPOOL_FINALIZER_ENABLED=false
HARVESTPOOL_FINALIZER_CONTRACT_ID=harvestpool-v5-usdc-dalamaa-20261109.testnet
HARVESTPOOL_FINALIZER_RPC_URL=https://rpc.testnet.fastnear.com
HARVESTPOOL_FINALIZER_RPC_TIMEOUT_SECONDS=10
HARVESTPOOL_FINALIZER_CREDENTIALS_FILE=/etc/harvestpool/finalizer.json
HARVESTPOOL_FINALIZER_DB=/var/lib/harvestpool-finalizer/finalizer.sqlite3
HARVESTPOOL_FINALIZER_POLL_SECONDS=60
HARVESTPOOL_FINALIZER_HEALTH_HOST=127.0.0.1
HARVESTPOOL_FINALIZER_HEALTH_PORT=8091
HARVESTPOOL_FINALIZER_HEALTH_STALE_SECONDS=180
# Hosted FastNEAR operation should inject FASTNEAR_API_KEY from a secret manager or this private file.
# FASTNEAR_API_KEY=
