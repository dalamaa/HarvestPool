# Public/read-only application settings only. Never place a NEAR private key here.
HARVESTPOOL_METADATA_DB=web/metadata.sqlite3
PORT=5010
NEAR_NETWORK=testnet
HARVESTPOOL_CONTRACT_ID=harvestpool-v4-dalamaa-20261109.testnet
HARVESTPOOL_CONTRACT_VERSION=V4
HARVESTPOOL_V3_CONTRACT_ID=harvestpool-v3-v4-dalamaa-20261109.testnet
# Set after deployment so shared links never copy localhost.
HARVESTPOOL_PUBLIC_BASE_URL=

# Optional V5 configuration after a separately authorized deployment and official-token journey.
# Do not point the public demo here until docs/v5-usdc.md deployment gates pass.
# HARVESTPOOL_CONTRACT_ID=<new-v5-account>.testnet
# HARVESTPOOL_CONTRACT_VERSION=V5
# HARVESTPOOL_V3_CONTRACT_ID=<new-v3-for-v5-account>.testnet

# Preserved V2 fallback (do not mix its V3 instance with V4):
# HARVESTPOOL_CONTRACT_ID=harvestpool-v2-dalamaa-20261108.testnet
# HARVESTPOOL_CONTRACT_VERSION=V2
# HARVESTPOOL_V3_CONTRACT_ID=harvestpool-v3-dalamaa-20261109.testnet
