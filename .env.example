# Public/read-only application settings only. Never place a NEAR private key here.
HARVESTPOOL_METADATA_DB=web/metadata.sqlite3
PORT=5011
NEAR_NETWORK=testnet
HARVESTPOOL_CONTRACT_ID=harvestpool-v5-usdc-dalamaa-20261109.testnet
HARVESTPOOL_CONTRACT_VERSION=V5
HARVESTPOOL_V3_CONTRACT_ID=harvestpool-v3-v5-dalamaa-20261109.testnet
HARVESTPOOL_USDC_TOKEN_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# Set after deployment so shared links never copy localhost.
HARVESTPOOL_PUBLIC_BASE_URL=

# The verified Community Fund is public read-only configuration. Its DAO is separate from V5
# purchase escrow. USDC is the customer-facing goal asset; proposal bonds and network gas still
# use Testnet NEAR.
HARVESTPOOL_COMMUNITY_DAO_ID=harvestpool-community.sputnikv2.testnet
HARVESTPOOL_COMMUNITY_GOAL_TITLE="Shared Community Equipment"
HARVESTPOOL_COMMUNITY_GOAL_PURPOSE="Fictional Testnet demonstration of a shared neighborhood equipment kit."
HARVESTPOOL_COMMUNITY_GOAL_RECIPIENT=harvestpool-farmer-1.testnet
HARVESTPOOL_COMMUNITY_GOAL_CURRENCY=USDC
HARVESTPOOL_COMMUNITY_GOAL_TARGET_USDC=1.00
# Optional public evidence manifest for a completed, fixed goal. When all fields are configured,
# HarvestPool verifies these exact finalized transactions through NEAR RPC instead of depending on
# indexer account-history discovery. Values are public hashes/accounts/base units, never secrets.
HARVESTPOOL_COMMUNITY_EVIDENCE_CONTRIBUTION_TX=JD8WYyoGFAxxNdApXDNrRfKpia59RAN41SWGDwZSGbE6
HARVESTPOOL_COMMUNITY_EVIDENCE_CONTRIBUTOR=harvestpool-member-a-2026.testnet
HARVESTPOOL_COMMUNITY_EVIDENCE_CONTRIBUTION_UNITS=1000000
HARVESTPOOL_COMMUNITY_EVIDENCE_PAYMENT_TX=DNBNDTgi6bEHsjnWX92WaS9v8U1nyhYiqxfKYKsnfA2p
HARVESTPOOL_COMMUNITY_EVIDENCE_PAYMENT_SIGNER=dalamaa.testnet
HARVESTPOOL_COMMUNITY_EVIDENCE_PAYMENT_PROPOSAL_ID=2
HARVESTPOOL_COMMUNITY_EVIDENCE_PAYMENT_RECEIPT=FwHKdUzhMXmfH1Ha6HHRTPBrid2MFVVS92JtCjKGrbHf
HARVESTPOOL_COMMUNITY_EVIDENCE_PAYMENT_UNITS=800000
# HARVESTPOOL_COMMUNITY_RPC_URL=https://rpc.testnet.fastnear.com
# HARVESTPOOL_NEARBLOCKS_API_KEY=optional-server-side-key

# Independent V5 finalization worker. Disabled unless intentionally provisioned.
HARVESTPOOL_FINALIZER_ENABLED=false
# HARVESTPOOL_FINALIZER_CONTRACT_ID=harvestpool-v5-usdc-dalamaa-20261109.testnet
# HARVESTPOOL_FINALIZER_RPC_URL=https://rpc.testnet.fastnear.com
# HARVESTPOOL_FINALIZER_RPC_TIMEOUT_SECONDS=10
# FASTNEAR_API_KEY=use-a-server-key-from-a-secret-store-for-hosted-operation
# Set deployment-owned private/persistent paths; do not copy credentials into this repository.
# HARVESTPOOL_FINALIZER_CREDENTIALS_FILE=/path-owned-by-service/finalizer.json
# HARVESTPOOL_FINALIZER_DB=/path-on-persistent-storage/finalizer.sqlite3
# HARVESTPOOL_FINALIZER_POLL_SECONDS=60
# HARVESTPOOL_FINALIZER_HEALTH_HOST=127.0.0.1
# HARVESTPOOL_FINALIZER_HEALTH_PORT=8091
# HARVESTPOOL_FINALIZER_HEALTH_STALE_SECONDS=180
# Optional comma-separated allowlist. Use HARVESTPOOL_FINALIZER_PURCHASE_IDS=4 for the Deal #4 canary.
# HARVESTPOOL_FINALIZER_PURCHASE_IDS=4

# Preserved legacy configurations are not valid root-script fallbacks. Use
# scripts/restart-v4.sh for the explicitly isolated V4 process.
# HARVESTPOOL_CONTRACT_ID=harvestpool-v2-dalamaa-20261108.testnet
# HARVESTPOOL_CONTRACT_VERSION=V2
# HARVESTPOOL_V3_CONTRACT_ID=harvestpool-v3-dalamaa-20261109.testnet
